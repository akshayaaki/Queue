# QueueFlow Environment Variables

# Database Configuration
# Production PostgreSQL (Supabase / Neon / Railway)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Authentication Secrets (generate 32+ character random secret)
AUTH_SECRET="queueflow-production-super-secure-jwt-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_NAME="QueueFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"
