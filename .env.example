# QueueFlow Environment Variables

# Database Configuration
# Default local SQLite database (for zero-config instant dev/testing)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL Database URL (uncomment and set for PostgreSQL / Supabase / Neon / Railway)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/queueflow?schema=public"

# Authentication Secrets
# Generate with: openssl rand -base64 32
AUTH_SECRET="queueflow-production-super-secure-jwt-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_NAME="QueueFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
